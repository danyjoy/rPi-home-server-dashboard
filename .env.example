# Home Server Command Center - environment configuration
# Copy to .env and adjust. Do NOT put real secrets in .env.example.
# Phase 1 has no secrets; these are non-sensitive runtime settings.

# ---- Ingress ----
# Port the dashboard is published on (frontend/nginx). Deliberately uncommon.
FRONTEND_PORT=9180

# ---- Backend host reads ----
# Where the host filesystem/proc/sys are mounted inside the backend container.
# On the Pi (via docker-compose) these point at the read-only host mounts.
# Leave the defaults unless you change the mount paths in docker-compose.yml.
HOST_PROC=/host/proc
HOST_SYS=/host/sys
HOST_ROOT=/host/root

# Comma-separated list of mounts to report under /api/storage.
# Format: name:path  (path is relative to the host root as seen by the backend)
# Example for the Pi with a media drive:
#   STORAGE_MOUNTS=root:/,media:/mnt/media
STORAGE_MOUNTS=root:/
